{
  // The public standalone studio: static files only (no server code), served by Cloudflare's static assets.
  // The account comes from the environment (CLOUDFLARE_ACCOUNT_ID in CI), never from this file.
  "name": "taswiq-design-studio",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false }
}
